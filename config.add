# ============================================================================
# config.add —— 本机（CMCC XR30 / NAND + MTK U-Boot）需要固件内置的能力
# 由 diy-part2.sh 在 make defconfig 之前写入 .config（覆盖同名旧值）
# 语法：一行一个 CONFIG_xxx=y / =n，不要写注释以外的多余符号
# ============================================================================

# --- REQ-01 iStore 软件中心 ---------------------------------------------------
# 依赖链：luci-app-store → luci-lib-taskd → taskd → script-utils / coreutils-stty
# 原 .config 里 script-utils 与 coreutils-stty 是显式 "is not set"，
# 链断在这里，defconfig 会把整个 luci-app-store 静默丢掉。
# （实测：只漏这两项时，verify 报 REQ-01 MISS，其余 9 项全过）
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_coreutils-stty=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_tar=y

# --- REQ-02 无线中继面板（mtwifi-cfg，apcli / STA 中继） ----------------------
# apcli 由驱动层的 MTK_APCLI_SUPPORT 打开（原 .config 已是 y）
CONFIG_MTK_APCLI_SUPPORT=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y

# --- REQ-03 USB 上网（RNDIS / NCM / ECM / QMI / MBIM + AT 口） ----------------
# USB 网卡框架：kmod-mii 是它的 DEPENDS（usb.mk 里写着 DEPENDS:=+kmod-mii），
# 本来会被自动带入，这里显式声明只是为了让清单可核对，值保持 y 不影响依赖解析
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_comgt-ncm=y

# USB 存储：两处用途，不是可选项
#   1) 部分 4G 模组出厂枚举成 CD-ROM（ZeroCD），usb_modeswitch 要把它 eject 掉
#      才能切到 modem 模式，这一步依赖内核认得出 USB 存储设备；
#   2) 插 U 盘扩 overlay / 放 OpenClash 内核 / iStore 装大包都需要它。
# kmod-scsi-core 是 kmod-usb-storage 的 DEPENDS，显式写出便于核对。
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-usb-storage=y

# --- REQ-04 QModem（模组管理，纯 JS 前端，不依赖 luci-compat） ----------------
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_qmodem=y

# --- REQ-05 OpenClash -------------------------------------------------------
# DEPENDS 会自动带 dnsmasq-full / curl / ca-bundle / ip-full / kmod-tun，
# 这里补齐它没在 DEPENDS 里声明、但运行必需的几项
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ipset=y

# --- REQ-06 网络硬件加速（MTK HNAT + WARP） ---------------------------------
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_MTK_WHNAT_SUPPORT=m
CONFIG_MTK_WARP_V2=y

# --- REQ-07 定时重启 --------------------------------------------------------
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# --- REQ-08 流量统计 --------------------------------------------------------
# nlbwmon 的统计库落在 /etc/nlbwmon（overlay 可写区），长期跑会持续写 NAND，
# 刷机后建议把「保留天数」调到 30 天以内，或把库目录改到 U 盘
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# --- REQ-09 网页终端 --------------------------------------------------------
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# --- REQ-10 SSH / SFTP（dropbear + sftp-server，不装 openssh-server） -------
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_openssh-sftp-server=y

# --- 编译期：关掉 perl 测试套件 ---------------------------------------------
# run 40526027536 挂在第 105 分钟，报错是：
#   perlbase.mk: perlbase-math ... rsync link_stat ".../perl-5.40.0/cpan/Math-BigRat/t" failed
#   make[3]: *** [perlbase.mk:915: perlbase-math-5.40.0-r6.apk] Error 23
# 原因：perlbase-math/install 里有一行 perlmod/InstallBaseTests，只拷测试用例，
# 而 perl 5.40 把 Math-BigRat 从 cpan/ 挪到了 dist/，源目录不存在。
# 这行只有在 CONFIG_PERL_TESTS 打开时才展开；固件不需要 perl 测试用例，
# 关掉即可（同时省掉几十 MB 的 perlbase-*-test 包）。
CONFIG_PERL_TESTS=n

# --- 编译加速：ccache -------------------------------------------------------
# workflow 里用 actions/cache 把 ~/.ccache 存下来，重跑时未改动的包直接命中，
# 能把这轮 90 分钟的编译压到十几分钟（配置/脚本改动不会让目标文件失效）。
CONFIG_CCACHE=y
